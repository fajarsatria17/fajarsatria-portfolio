# Application Environment Variables
# Note: Never commit sensitive tokens or secret API keys to this file or Git.

# Public Site URL
VITE_SITE_URL=https://your-portfolio-domain.com

# Formspree Contact Form Endpoint ID
# (Obtain from https://formspree.io/forms)
VITE_FORMSPREE_FORM_ID=xpzgvxxx

# Analytics (Optional)
VITE_ENABLE_ANALYTICS=false
